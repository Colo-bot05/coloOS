# =============================================================================
# Colobiz AI Workspace - Environment Variables (sample)
# =============================================================================
# 本ファイルはサンプルです。実値は絶対にコミットしないこと（CLAUDE.md §11 / §12.3）。
# ローカル開発: 本ファイルを `.env.local` にコピーして値を入れる（.env.local は .gitignore 対象）
# 本番/STG    : 値は AWS Secrets Manager / SSM Parameter Store から注入する
# =============================================================================

# ---- 共通 -------------------------------------------------------------------
ENV=local                          # local / stg / prod
LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR

# ---- DB / Cache -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://colobiz:colobiz@localhost:5432/colobiz_ai
REDIS_URL=redis://localhost:6379/0

# ---- Auth: Amazon Cognito + Google Workspace IdP federation -----------------
# 社員ログインは Google Workspace IdP（colobiz.co.jp ドメイン）。
# 内部 RBAC は Cognito グループ。詳細は STEP0 詳細設計書 §14.3 / ISSUE_ST0-6。
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_HOSTED_UI_DOMAIN=
COGNITO_OAUTH_REDIRECT_SIGNIN=http://localhost:3000/auth/callback
COGNITO_OAUTH_REDIRECT_SIGNOUT=http://localhost:3000/
GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET は本番では Secrets Manager 経由。ローカル開発のみ .env.local に記述。
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=colobiz.co.jp

# ---- LLM Providers ----------------------------------------------------------
# 業務コードからは LLM Router 経由でのみ呼ぶ（CLAUDE.md §9 / §12.5）。
# モデル ID をここに書かないこと（モデル ID は infra/config/llm_routes.yaml で集中管理）。
BEDROCK_REGION=us-west-2
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01
GCP_PROJECT_ID=
VERTEX_LOCATION=us-central1

# ---- LLM Routes -------------------------------------------------------------
# 役割（chat.default / requirements.final / review.miyamoto 等）→ Provider/モデル
# のマッピング（CLAUDE.md §9.3）。
LLM_ROUTES_FILE=infra/config/llm_routes.yaml

# ---- Decision Engine --------------------------------------------------------
# 思考OS：判断軸 / 3視点レビュー / 逆算順算 / 3要素評価 / 再現性チェック
# 詳細は CLAUDE.md §10 / §12.10 および DecisionEngine 詳細設計書。
# ※ ここのキー名は ST0-1 暫定。Decision Engine 実装 Issue（後続）で正式確定する。
DECISION_ENGINE_ENABLED=true
DECISION_PROMPTS_DIR=packages/prompts/decision
REVIEW_PROMPTS_DIR=packages/prompts/review
DECISION_DEFAULT_REVIEW_ROLES=miyamoto,yoshida,kashiwabara,colobiz
DECISION_INCLUDE_AXES_DEFAULT=true
